# ============ Python 运行缓存 ============
__pycache__/
*.py[cod]
*.pyc
*.egg-info/
.venv/
venv/

# ============ PyInstaller 构建产物 ============
build/
dist/
督办系统-发行版.zip

# ============ 归档区：历史产物 / 旧交付包 / 过期快照，均不入版本库 ============
# 内含 build/ dist/ 发行版 zip / env_info.txt / v1-v2 交付包目录（约 105MB）
_archive/

# ============ 交付包：保留文档与脚本，忽略体积巨大的二进制 ============
# 05_离线程序 内含 Python 运行时（pyd/dll/exe），单份约 40MB，不入版本库
deliverables/**/*.zip
deliverables/**/05_离线程序/
deliverables/**/*.exe
deliverables/**/*.pyd
deliverables/**/*.dll

# ============ 数据库运行时数据与备份 ============
# 数据库是"运行出来的数据"而非源码，不入库；data/.gitkeep 保留目录结构
data/*.db
data/**/*.db.bak-*
# SQLite 运行时临时文件（预写日志 -wal 与共享内存 -shm，服务/测试运行时自动生成）
*.db-wal
*.db-shm

# 会话签名密钥：每个部署实例启动时自动生成，属敏感运行数据，严禁入库
# （若随源码分发，所有实例将共用同一把密钥，等同于没有防护）
data/secret.key

# 备份脚本生成的备份目录（运行产物，含业务数据副本，不入库）
backups/

# 测试数据库：每次跑测试会重建，属运行产物
test_data/

# ============ 日志与环境快照 ============
*.log
env_info.txt

# 运行期生成的日志目录（内容随环境变化，不入库）
logs/

# ============ 本地环境变量（可能含密钥，严禁入库） ============
# .env.example 是模板，需入库；.env 是本地实际配置，不入库
.env
!.env.example

# ============ 编辑器 / 系统 ============
.vscode/
.idea/
.DS_Store
Thumbs.db
