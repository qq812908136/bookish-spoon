# ============================================================
# 督办系统 — 环境变量配置示例
# ============================================================
# 使用方法：
#   1. 复制本文件为 .env（放在与 督办系统.exe 同级目录，或项目根目录）
#   2. 按需修改下面的值
#   3. 重启程序生效
#
# 优先级：系统环境变量 > .env 文件 > 代码默认值
# 本文件中**所有**配置项都是可选的：
#   不写 = 沿用代码默认值，行为与不配 .env 时完全一致。
#
# 安全提醒：
#   .env 已在 .gitignore 中，不会被提交到版本库，切勿手动加入。

# ------------------------------------------------------------
# 安全配置
# ------------------------------------------------------------
# Flask session 签名密钥。
# **通常不需要配置**：程序会在首次启动时自动生成随机密钥，
# 写入 data/secret.key 并长期复用，每个部署实例的密钥都不相同。
#
# 仅在以下情况才需要显式指定：
#   - 多台机器部署、希望它们共享会话（例如负载均衡后不希望频繁掉线）
#   - 部署目录只读、无法写入 data/secret.key
#   - 密钥需要轮换（改这里并重启，所有用户会被强制重新登录）
#
# 手动生成：python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=把这里换成你的随机字符串

# ------------------------------------------------------------
# 服务器配置
# ------------------------------------------------------------
# 监听地址：
#   127.0.0.1 = 仅本机可访问（**默认值**）
#   0.0.0.0   = 监听所有网卡，局域网其他设备也能访问
#
# 需要局域网访问时不用改这里 —— 直接双击「局域网启动.bat」，
# 它会在启动时临时设置 HOST=0.0.0.0，不影响你平时的默认行为。
# 只有在想把「局域网」固定成这台机器的常态时才写进 .env。
# HOST=127.0.0.1

# 监听端口（默认 5000）。端口被占用时可改成 5001、8080 等
# PORT=5000

# 调试模式：本地开发可设 true；**打包发布必须为 false**
# 开启后异常会在页面显示堆栈，可能泄露敏感信息
# DEBUG=false

# 运行载体：
#   flask    = Werkzeug 开发服务器（默认，够用于本机/内网小规模）
#   waitress = 生产级 WSGI 服务器（需先 pip install waitress；没装会自动回退）
# 正式上线建议用 waitress，详见 docs/生产部署指南.md
# SERVER=flask

# ------------------------------------------------------------
# CSRF 防护（DEF-002）
# ------------------------------------------------------------
# 是否校验写请求的 CSRF 令牌（默认 true）
# 关掉后任何外部页面都能以已登录用户的身份提交表单
# （删任务、改状态、建管理员账号），仅排障时临时关闭
# CSRF_ENABLED=true

# 令牌有效期（秒，默认 86400 = 24 小时）
# 页面停留超过这个时长后再提交会提示刷新页面。
# 调大 = 少打扰，代价是令牌万一泄露后的可用窗口更长
# CSRF_TOKEN_MAX_AGE=86400

# ------------------------------------------------------------
# 会话 Cookie 安全属性
# ------------------------------------------------------------
# 禁止 JS 读取会话 Cookie（默认 true）
# SESSION_COOKIE_HTTPONLY=true

# 跨站请求时是否发送会话 Cookie（默认 Lax）
#   Lax    = 跨站发起的 POST 不带 Cookie —— 这是 CSRF 的第一道防线
#   Strict = 更严格，但从外站链接跳进来会丢失登录态
#   None   = 完全不限制（不推荐）
# SESSION_COOKIE_SAMESITE=Lax

# 仅通过 HTTPS 传输会话 Cookie（默认 false）
# 启用 HTTPS 后**务必**设为 true，否则会话 Cookie 会明文传输。
# 注意：纯 HTTP 的内网环境设成 true 会导致无法登录。
# SESSION_COOKIE_SECURE=false

# ------------------------------------------------------------
# 登录安全（DEF-005）
# ------------------------------------------------------------
# 同一「客户端 IP + 用户名」连续失败多少次后临时锁定（默认 5）
# 调大 = 更宽容；设为 0 = 关闭限流（不推荐，仅用于排障）
# LOGIN_MAX_ATTEMPTS=5

# 锁定时长（分钟），从最后一次失败起算（默认 15）
# 锁定期内即使输入正确密码也会被拒绝
# LOGIN_LOCKOUT_MINUTES=15

# 密码最小长度（默认 8）
# 只作用于**设置密码的时刻**（初始化向导 / 新建用户 / 改密码 / 重置密码），
# 不追溯已有账号——早期创建的 6 位密码账号仍可登录，改密码时才要求达标
# PASSWORD_MIN_LENGTH=8

# 是否启用弱口令拦截（默认 true）
# 拦截项：纯数字、纯字母、常见弱口令黑名单、与用户名相同
# 设 false 则只保留上面的最小长度校验
# PASSWORD_REQUIRE_STRENGTH=true

# ------------------------------------------------------------
# 反向代理（仅当系统部署在 Nginx / Caddy 后面时才需要）
# ------------------------------------------------------------
# 不开启的话，应用看到的来源 IP 全是代理服务器的地址，
# 会导致登录限流「一人被锁、全员陪绑」，日志里的 IP 也没有参考价值。
#
# ⚠️ 没有反向代理时务必保持 false：开启意味着信任 X-Forwarded-* 请求头，
#    若实际没有代理，攻击者可以自己伪造该头绕过登录限流。
# BEHIND_PROXY=false

# 信任几层代理，**必须等于实际层数**（1 = 只有 Nginx/Caddy；2 = CDN + Nginx）
# 填大了会让攻击者有机会伪造更靠前的 X-Forwarded-For 绕过限流
# BEHIND_PROXY_TRUSTED_HOPS=1

# ------------------------------------------------------------
# 日志配置
# ------------------------------------------------------------
# 日志级别：DEBUG / INFO / WARNING / ERROR（默认 INFO）
# 排查问题时可临时改为 DEBUG，问题解决后改回 INFO
# LOG_LEVEL=INFO

# 单个日志文件大小上限（字节），超过后自动轮转（默认 2097152 = 2MB）
# LOG_MAX_BYTES=2097152

# 轮转保留的历史日志文件个数（默认 5）
# LOG_BACKUP_COUNT=5
